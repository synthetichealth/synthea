        { "system": "http://synthea.mitre.org/pathology/subspecialty", "code": "neuro", "display": "Neuropathology" }
      ],
      "direct_transition": "End Encounter"
    },
    "Heme Report": {
      "type": "PathologyReport",
      "subspecialty": "heme",
      "codes": [
        { "system": "LOINC", "code": "11502-2", "display": "Surgical pathology report" },
        { "system": "http://synthea.mitre.org/pathology/subspecialty", "code": "heme", "display": "Hematopathology" }
      ],
      "direct_transition": "End Encounter"
    },
    "Cytology Report": {
      "type": "PathologyReport",
