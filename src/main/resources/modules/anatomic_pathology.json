        { "system": "LOINC", "code": "11502-2", "display": "Surgical pathology report" },
        { "system": "http://synthea.mitre.org/pathology/subspecialty", "code": "cytology", "display": "Cytopathology" }
      ],
      "direct_transition": "End Encounter"
    },
    "Thoracic Report": {
      "type": "PathologyReport",
      "subspecialty": "thoracic",
      "codes": [
        { "system": "LOINC", "code": "11502-2", "display": "Surgical pathology report" },
        { "system": "http://synthea.mitre.org/pathology/subspecialty", "code": "thoracic", "display": "Thoracic pathology" }
      ],
      "direct_transition": "End Encounter"
    },
    "Eye Report": {
      "type": "PathologyReport",
      "subspecialty": "eye",
      "codes": [
