# Build metadata for docker build / docker compose build
SYNTHEA_VERSION=docker-compose

# Output path inside the container. Keep this aligned with the bind mount target.
SYNTHEA_OUTPUT_DIR=/synthea-output

# Supported values:
# fhir | bulk_fhir | fhir_stu3 | fhir_dstu2 | ccda | json | csv | cpcds | bfd | cdw | text | clinical_note
# Multiple formats can be enabled with commas, for example: fhir,csv
SYNTHEA_OUTPUT_FORMAT=fhir

# Default generation settings for the container runtime.
SYNTHEA_POPULATION=10
SYNTHEA_STATE=Massachusetts
SYNTHEA_CITY=

# Optional generator controls.
SYNTHEA_SEED=
SYNTHEA_CLINICIAN_SEED=
SYNTHEA_SINGLE_PERSON_SEED=

# Dates must use YYYYMMDD.
SYNTHEA_REFERENCE_DATE=
SYNTHEA_END_DATE=

# Supported values: M | F
SYNTHEA_GENDER=

# Format: min-max, for example 60-65
SYNTHEA_AGE_RANGE=

# Supported values: true | false
SYNTHEA_OVERFLOW=

# Module filter values are passed to -m and should use the OS path separator.
# On Linux and macOS that means ':', for example: copd:allergies
SYNTHEA_MODULES=

# Path-based options below must point to paths visible inside the container.
# Add extra volume mounts in compose.yaml if you want to use host files or directories here.
SYNTHEA_CONFIG_FILE=
SYNTHEA_LOCAL_MODULES_DIR=
SYNTHEA_INITIAL_SNAPSHOT=
SYNTHEA_UPDATED_SNAPSHOT=
SYNTHEA_UPDATE_DAYS=
SYNTHEA_FIXED_RECORD_PATH=
SYNTHEA_KEEP_PATIENTS_PATH=